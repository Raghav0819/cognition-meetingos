rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  HELPER FUNCTIONS                                               ║
    // ╚══════════════════════════════════════════════════════════════════╝

    // Returns true if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user is the document owner
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Returns the current user's profile document data
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns true if the user belongs to the specified company
    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserProfile().companyId == companyId;
    }

    // Returns true if the field has not been modified in this write.
    // Guards against comparing against a field that doesn't exist yet on
    // the existing document (e.g. companyId before a user has joined one) —
    // accessing a missing map key would otherwise throw and deny the write.
    function fieldUnchanged(field) {
      return !(field in request.resource.data)
          || (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  USERS COLLECTION                                               ║
    // ║  /users/{uid}                                                   ║
    // ║                                                                 ║
    // ║  Every authenticated user can read and update ONLY their own     ║
    // ║  user document. No user can ever read or modify another user's   ║
    // ║  document.                                                      ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /users/{uid} {

      // READ: A user can only read their OWN document.
      // Prevents any user from reading another user's profile, email,
      // role, or company association.
      allow read: if isOwner(uid);

      // CREATE: A user can create their own profile document during signup.
      // Constraints:
      //   - Must be their own UID (isOwner)
      //   - Must include name, email, and role
      //   - Role must be one of the three valid values
      //   - Email must match their Firebase Auth email (prevents spoofing)
      //   - companyId must NOT be set during creation (set during join flow)
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
                    && request.resource.data.role in ['pm', 'employee', 'manager']
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.createdAt == request.time
                    && !('companyId' in request.resource.data);

      // UPDATE: A user can update their own profile with restrictions.
      // Security constraints:
      //   1. Cannot change 'role'      → prevents privilege escalation
      //   2. Cannot change 'email'     → must stay synced with Firebase Auth
      //   3. Can set 'companyId' ONCE  → when field doesn't exist yet
      //   4. Cannot change 'companyId' → prevents company hopping after joining
      //   5. Can update 'name' freely
      //   6. Must set 'updatedAt' to current server time
      allow update: if isOwner(uid)
                    && fieldUnchanged('role')
                    && fieldUnchanged('email')
                    && request.resource.data.updatedAt == request.time
                    && (
                      // Case 1: companyId not being changed (normal profile update)
                      fieldUnchanged('companyId')
                      ||
                      // Case 2: Setting companyId for the first time (joining a company)
                      (!('companyId' in resource.data) && 'companyId' in request.resource.data)
                    );

      // DELETE: Users cannot delete their own profiles from the client.
      // Account deletion should be handled by a Cloud Function or admin action.
      allow delete: if false;
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  COMPANIES COLLECTION                                           ║
    // ║  /companies/{companyId}                                         ║
    // ║                                                                 ║
    // ║  Invite code lookup is handled by the backend (Admin SDK).       ║
    // ║  Clients can only read their own company doc or create one.      ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /companies/{companyId} {

      // READ (get): Only company members can read their own company doc.
      // The belongsToCompany() helper verifies the user's companyId matches.
      // Enforces company isolation — users cannot read other companies.
      allow get: if belongsToCompany(companyId);

      // READ (list/query): Denied. Invite code lookup is handled by the
      // backend endpoint /companies/lookup which uses the Admin SDK.
      // Firestore rules cannot inspect query where() clauses, so client-side
      // querying of companies is not secure.
      allow list: if false;

      // CREATE: Authenticated users without a company can create one.
      // The createdBy field must match the authenticated user's UID.
      // Required fields are validated to ensure data integrity.
      allow create: if isAuthenticated()
                    && !('companyId' in getUserProfile())
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['name', 'inviteCode', 'createdBy', 'createdAt']);

      // UPDATE/DELETE: Companies cannot be modified or deleted from the client.
      // Company management should be done via Cloud Functions or admin panel.
      allow update: if false;
      allow delete: if false;

      // Company Chat Messages
      match /messages/{messageId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.keys().hasAll(['text', 'senderId', 'senderName', 'senderRole', 'createdAt'])
                      && request.resource.data.createdAt == request.time;
      }
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  MEETINGS COLLECTION (TOP-LEVEL)                                ║
    // ║  /meetings/{meetingId}                                          ║
    // ║                                                                 ║
    // ║  All meeting CRUD is performed by the FastAPI backend using the  ║
    // ║  Firebase Admin SDK, which bypasses security rules entirely.     ║
    // ║  No client should ever directly access meeting documents.        ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /meetings/{meetingId} {
      allow read, write: if false;

      // Sub-collections (participants, logs) are also backend-only.
      match /{subcollection=**} {
        allow read, write: if false;
      }
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  TASKS COLLECTION (TOP-LEVEL)                                   ║
    // ║  /tasks/{taskId}                                                ║
    // ║                                                                 ║
    // ║  All task operations (creation by CrewAI, status updates,       ║
    // ║  validation) are performed through the FastAPI backend API.      ║
    // ║  The frontend uses Axios → backend, not Firestore directly.     ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /tasks/{taskId} {
      allow read, write: if false;
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  CATCH-ALL: Deny everything else                                ║
    // ║  Any collection not explicitly listed above is denied by         ║
    // ║  default. This is the principle of least privilege.              ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
